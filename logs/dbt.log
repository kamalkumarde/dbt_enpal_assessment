  create  table "postgres"."public"."fct_funnel_kpi_monthly__dbt_tmp"
  
  
    as
  
  (
    with  __dbt__cte__int_months_spine as (
with range_values as (
    select min(change_time) as start_date, max(change_time) as end_date 
    from "postgres"."public"."stg_deal_changes"
)
select generate_series(start_date, end_date, '1 month')::date as month
from range_values
),  __dbt__cte__int_field_configs as (
select
    field_key,
    name as field_display_name,
    elem ->> 'id' as option_id,
    elem ->> 'label' as option_name
from "postgres"."public"."fields"
cross join lateral jsonb_array_elements(field_value_options) as elem
),  __dbt__cte__int_funnel_stages as (
with stage_history as (
    select
        deal_id,
        change_time,
