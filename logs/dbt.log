  create  table "postgres"."public"."fct_funnel_kpi_monthly__dbt_tmp"
  
  
    as
  
  (
    with months as (
    select month from "postgres"."public"."int_months_spine"
),

unioned_logic as (
    -- 1. Stages & Lost Reasons (Steps 1, 10, etc.)
    select month, kpi_name, step, deal_id 
    from "postgres"."public"."int_funnel_stages"
    
    union all
    
    -- 2. Activities (Steps 2.1, 3.1, etc.)
    -- This now correctly uses the model where the macro is applied!
    select month, kpi_name, step, deal_id 
    from "postgres"."public"."int_funnel_activities"
    
    union all

    -- 3. Metadata Changes (Step 0, 0.1, etc.)
    select month, kpi_name, step, deal_id
    from "postgres"."public"."int_funnel_metadata_changes"
)

select 
    to_char(ms.month_date, 'YYYY-MM') as year_month, 
    coalesce(ul.kpi_name, 'No Activity') as kpi_name,
    ul.step,
    count(distinct ul.deal_id) as deal_count
from months ms
left join unioned_logic ul on ms.month = ul.month
where ul.step >= 1 and ul.step <= 9  -- remove this line to include all steps
group by 1, 2, 3
having kpi_name is not null
order by step, month
  );
  
