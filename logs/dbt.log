  create  table "postgres"."public_pipedrive_analytics"."fct_funnel_kpi_monthly__dbt_tmp"
  
  
    as
  
  (
    with months as (
    select month from "postgres"."public_pipedrive_analytics"."int_months_spine"
),

unioned_logic as (
    -- Stages & Lost Reasons
    select month, kpi_name, step, deal_id from "postgres"."public_pipedrive_analytics"."int_funnel_stages"
    
    union all
    
    -- Activities
    select 
        
    DATE_TRUNC('month', a.due_to)::date
 as month,
        t.name as kpi_name,
        
    CASE t.name
        WHEN 'Sales Call 1' THEN 2.1
        WHEN 'Sales Call 2' THEN 3.1
        WHEN 'Follow Up Call' THEN 14.1
        WHEN 'After Close Call' THEN 15.1
        ELSE NULL
    END
 as step,
        a.deal_id
    from "postgres"."public"."activity" a
    join "postgres"."public"."activity_types" t on a.type = t.type
    where 
    CASE t.name
        WHEN 'Sales Call 1' THEN 2.1
        WHEN 'Sales Call 2' THEN 3.1
        WHEN 'Follow Up Call' THEN 14.1
        WHEN 'After Close Call' THEN 15.1
        ELSE NULL
    END
 is not null
)

select 
    ms.month,
    ul.kpi_name,
    ul.step,
    count(distinct ul.deal_id) as deal_count
from months ms
left join unioned_logic ul on ms.month = ul.month
group by 1, 2, 3
having kpi_name is not null
order by step, month
  );
  
