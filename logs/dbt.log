  create  table "postgres"."public"."fct_funnel_kpi_monthly__dbt_tmp"
  
  
    as
  
  (
    with months as (
    -- Updated to match the name in int_months_spine
    select month_date from "postgres"."public"."int_months_spine"
),

unioned_logic as (
    select month, kpi_name, step, deal_id from "postgres"."public"."int_funnel_stages"
    union all
    select month, kpi_name, step, deal_id from "postgres"."public"."int_funnel_activities"
    union all
    select month, kpi_name, step, deal_id from "postgres"."public"."int_funnel_metadata_changes"
)

select 
    to_char(ms.month_date, 'YYYY-MM') as year_month, 
    coalesce(ul.kpi_name, 'No Activity') as kpi_name,
    ul.step,
    count(distinct ul.deal_id) as deal_count
from months ms
left join unioned_logic ul 
    on ms.month_date = ul.month -- Joining the spine to the data
where (ul.step >= 1 and ul.step <= 9) or ul.step is null -- remove this line
group by ms.month_date, ul.kpi_name, ul.step -- Added ms.month_date for proper sorting
order by ul.step,ms.month_date
  );
  
