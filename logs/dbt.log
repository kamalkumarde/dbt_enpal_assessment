    select *
    from (
        with  __dbt__cte__int_months_spine as (
with range_values as (
    select min(change_time) as start_date, max(change_time) as end_date 
    from "postgres"."public"."stg_deal_changes"
)
select generate_series(start_date, end_date, '1 month')::date as month
from range_values
),  __dbt__cte__int_field_configs as (
select
    field_key,
    name as field_display_name,
    elem ->> 'id' as option_id,
    elem ->> 'label' as option_name
from "postgres"."public"."fields"
cross join lateral jsonb_array_elements(field_value_options) as elem
),  __dbt__cte__int_funnel_stages as (
with stage_history as (
    select
        deal_id,
        change_time,
        new_value::integer as option_id,
        changed_field_key
    from "postgres"."public"."stg_deal_changes"
    where changed_field_key in ('stage_id', 'lost_reason')
)
select 
    
    DATE_TRUNC('month', h.change_time)::date
 as month,
    conf.option_name as kpi_name,
    case 
        when h.changed_field_key = 'stage_id' then conf.option_id::float 
        else conf.option_id::float + 10 
    end as step,
    h.deal_id
from stage_history h
join __dbt__cte__int_field_configs conf 
    on h.option_id = conf.option_id::integer 
    and h.changed_field_key = conf.field_key
), months as (
    select month from __dbt__cte__int_months_spine
),

unioned_logic as (
    -- Stages & Lost Reasons
    select month, kpi_name, step, deal_id from __dbt__cte__int_funnel_stages
    
    union all
    
    -- Activities
    select 
        
    DATE_TRUNC('month', a.due_to)::date
 as month,
        t.name as kpi_name,
        
    CASE t.name
        WHEN 'Sales Call 1' THEN 2.1
        WHEN 'Sales Call 2' THEN 3.1
        WHEN 'Follow Up Call' THEN 14.1
        WHEN 'After Close Call' THEN 15.1
        ELSE NULL
    END
 as step,
        a.deal_id
    from "postgres"."public"."activity" a
    join "postgres"."public"."activity_types" t on a.type = t.type
    where 
    CASE t.name
        WHEN 'Sales Call 1' THEN 2.1
        WHEN 'Sales Call 2' THEN 3.1
        WHEN 'Follow Up Call' THEN 14.1
        WHEN 'After Close Call' THEN 15.1
        ELSE NULL
    END
 is not null
)

select 
    ms.month,
    ul.kpi_name,
    ul.step,
    count(distinct ul.deal_id) as deal_count
from months ms
left join unioned_logic ul on ms.month = ul.month
group by 1, 2, 3
having kpi_name is not null
order by step, month
    ) as model_limit_subq
    limit 20


